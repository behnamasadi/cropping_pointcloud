# Pick a ROS 2 + Gazebo pairing. The compose file reads these.
# Default: Humble + Fortress.
# To switch to Jazzy + Harmonic, comment out the first triple and use the second.

ROS_DISTRO=humble
GZ_PKG=ignition-fortress
GZ_CMD=ign gazebo

# ROS_DISTRO=jazzy
# GZ_PKG=gz-harmonic
# GZ_CMD=gz sim

# DDS hygiene shared by every service.
ROS_DOMAIN_ID=42
