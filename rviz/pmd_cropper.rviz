Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Raw1
        - /Cropped1
        - /Object1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
      Plane: XY
      Line Style:
        Value: Lines
        Line Width: 0.03

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.1

    - Class: rviz_default_plugins/MarkerArray
      Name: Crop Bounds
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /crop_bounds
      Namespaces:
        crop_bounds: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: { Max Value: 10, Min Value: -10, Value: true }
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Raw
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /pmd_royale_ros_camera_node/point_cloud_0
      Use Fixed Frame: true
      Use rainbow: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: { Max Value: 10, Min Value: -10, Value: true }
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 239; 41; 41
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Cropped
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.04
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /cropped_cloud
      Use Fixed Frame: true
      Use rainbow: true

    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: { Max Value: 10, Min Value: -10, Value: true }
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 78; 154; 6
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Object
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 5
      Size (m): 0.05
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /object_cloud
      Use Fixed Frame: true
      Use rainbow: true

  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    # Camera "body" frame (ROS REP-103: X forward, Y left, Z up). The driver
    # also publishes the optical frame `pmd_royale_ros_camera_node_optical_frame`
    # (OpenCV / OpenGL-ish: X right, Y down, Z forward) which the point cloud
    # is stamped with. The static TF between them handles the swap, so picking
    # the link frame here gives a natural "forward = +X horizontally" view.
    # Switch to the optical frame from Global Options → Fixed Frame if you'd
    # rather see depth along Z.
    Fixed Frame: pmd_royale_ros_camera_node_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      # PMD desk-scale view: orbit around a focal point ~30 cm ahead of the
      # camera (where the cropped slab sits) at ~1.2 m distance, with a slight
      # downward tilt so the bounding box and the cloud are both in frame.
      Distance: 1.2
      Focal Point: { X: 0.3, Y: 0, Z: 0 }
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.02
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.4
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 3.1
    Saved: ~

Window Geometry:
  Displays: { collapsed: false }
  Height: 800
  Width: 1280
  Selection: { collapsed: false }
  Tool Properties: { collapsed: false }
  Views: { collapsed: false }
  Hide Left Dock: false
  Hide Right Dock: true
